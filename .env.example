# Solana Devnet RPC endpoint
RPC_ENDPOINT=https://api.devnet.solana.com

# Payer / Update Authority private key
# Supported formats:
# 1. Base58 encoded string: e.g. 5Mii9...
# 2. JSON array of 64 bytes: e.g. [12,34,56,...]
# If left empty, scripts will automatically generate and persist a devnet keypair into keys/payer.json
PRIVATE_KEY=

# Optional: Dedicated recipient wallet public key
# If left empty, scripts will automatically generate a recipient keypair
RECIPIENT_PUBLIC_KEY=
